# AI パーソナルラジオ局 - 環境変数雛形
# このファイルを .env としてコピーし、値を設定してください。
# .env は .gitignore でGit管理対象外です。

# --- GitHub（GitHub Actions で自動設定されるため、ローカル開発時のみ設定）---
VITE_GITHUB_REPO=owner/repo-name
VITE_BASE=./

# --- Nextcloud Talk 通知（設定済み時のみ有効、未設定なら通知スキップ）---
# 方式1: Bot Webhook
NEXTCLOUD_TALK_WEBHOOK_URL=https://cloud.example.com/index.php/apps/spreed/webhook/xxx
NEXTCLOUD_BOT_SECRET=your-webhook-secret

# 方式2: OCS API（アプリパスワード）
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_TALK_TOKEN=your-app-password-or-bearer-token
NEXTCLOUD_TALK_ROOM_ID=your-room-id

# --- Gemini API（Google AI Studio 無料枠）---
# GEMINI_API_KEY=your-gemini-api-key

# --- PWA ページURL（GitHub Actions で自動設定）---
# PWA_BASE_URL=https://owner.github.io/repo-name/
